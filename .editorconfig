# Same layout in every editor, and for the agent: tabs in GDScript and shell
# (what gdformat writes), two spaces elsewhere.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{gd,sh}]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
