{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(mise run check)",
      "Bash(mise run test)",
      "Bash(mise run lint)",
      "Bash(mise run smoke)",
      "Bash(mise run import)",
      "Bash(mise run export)",
      "Bash(mise run export-smoke)",
      "Bash(mise run validate)",
      "Bash(mise run web-smoke)",
      "Bash(mise run mouse-check)",
      "Bash(mise run shots)",
      "Bash(tools/gdunit.sh *)",
      "Bash(godot --headless *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "mcp__godot-ai__editor_state",
      "mcp__godot-ai__scene_get_hierarchy",
      "mcp__godot-ai__node_get_properties",
      "mcp__godot-ai__session_activate",
      "mcp__godot-ai__session_manage",
      "mcp__godot-ai__logs_read",
      "mcp__godot-ai__editor_screenshot",
      "mcp__godot-ai__project_run",
      "mcp__godot-ai__game_manage",
      "mcp__godot-ai__test_run"
    ],
    "deny": [
      "Edit(**/*.tscn)",
      "Edit(**/*.tres)",
      "Edit(**/*.uid)",
      "Edit(/addons/gdUnit4/**)",
      "Edit(/addons/godot_ai/**)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(/.godot/export_credentials.cfg)",
      "Read(**/*.keystore)",
      "Read(**/*.p12)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(/.claude/**)",
      "Edit(/.mcp.json)",
      "Edit(/tools/claude/**)",
      "Edit(/gdlintrc)",
      "Edit(/mise.toml)",
      "Edit(/.github/**)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "enabledMcpjsonServers": [
    "godot-ai"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/tools/claude/post_edit_gd.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.claude/hooks/check-before-stop.sh",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
