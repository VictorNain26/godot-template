{
  "permissions": {
    "allow": [
      "Bash(mise run *)",
      "Bash(godot --headless *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/tools/claude/post_edit_gd.sh",
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && mise run check 1>&2 || exit 2",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
