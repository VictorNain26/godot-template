{
  "permissions": {
    "allow": [
      "Bash(mise run test)",
      "Bash(godot --headless *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR}\" && mise run test 1>&2 || exit 2",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
