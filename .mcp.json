{
  "mcpServers": {
    "godot-ai": {
      "type": "stdio",
      "command": "/mnt/c/Users/ordiv/.local/bin/uvx.exe",
      "args": [
        "--isolated",
        "--no-config",
        "--no-env-file",
        "--no-sources",
        "--no-build",
        "--index-strategy",
        "first-index",
        "--keyring-provider",
        "disabled",
        "--exclude-newer",
        "2026-11-01T19:00:00Z",
        "--exclude-newer-package",
        "godot-ai=false",
        "--index",
        "https://pypi.org/simple",
        "--default-index",
        "https://pypi.org/simple",
        "--find-links",
        "https://pypi.org/simple/godot-ai/",
        "--link-mode",
        "copy",
        "--from",
        "godot-ai==4.4.0",
        "godot-ai",
        "attach",
        "--port",
        "8000",
        "--ws-port",
        "9500"
      ]
    },
    "godot-runtime": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "${CLAUDE_PROJECT_DIR:-.}/tools/mcp_runtime.sh"
      ],
      "env": {
        "GODOT_MCP_DISABLE_ELICITATION": "true"
      }
    }
  }
}
